# Copiază în .env (ignorat de git) și ajustează dacă e nevoie.
# Valorile de mai jos sunt și default-urile din docker-compose.yml.

POSTGRES_USER=nexero
POSTGRES_PASSWORD=nexero
POSTGRES_DB=nexero
POSTGRES_PORT=5432

# Folosit de aplicația NestJS (Prisma) pentru conexiune — vezi prisma/schema.prisma.
DATABASE_URL=postgresql://nexero:nexero@localhost:5432/nexero?schema=public

# Secret de semnare JWT (src/auth/) — generează unul propriu, ex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NICIODATĂ aceeași valoare în producție ca în dev.
JWT_SECRET=schimbă-mă-cu-un-secret-generat-aleator
JWT_EXPIRES_IN=1h
