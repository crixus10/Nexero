{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // composite:true nu poate avea noEmit:true (TS respinge combinația) —
    // outDir explicit ca să nu mai apară vite.config.js/.d.ts/.js.map
    // lângă sursă la rădăcina web/ (s-a întâmplat o dată, curățat manual).
    "outDir": "./node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}
