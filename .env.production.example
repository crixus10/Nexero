# Șablon pentru PRODUCȚIE — vezi docs/deploy.md, pasul 6.
# Pe server: copiază ca ".env" (exact acest nume — docker-compose.prod.yml
# și Docker Compose însuși citesc automat ".env" din același folder),
# completează valorile reale, apoi `chmod 600 .env`.
#
# NICIODATĂ valorile din .env.example (dev) aici, și NICIODATĂ acest
# fișier completat nu se commite în git (deja acoperit de .gitignore).

# Generează cu: openssl rand -hex 24
POSTGRES_USER=nexero_prod
POSTGRES_PASSWORD=schimbă-mă-generat-cu-openssl
POSTGRES_DB=nexero

# DATABASE_URL NU se pune aici — se compune automat în
# docker-compose.prod.yml din variabilele POSTGRES_* de mai sus
# (Postgres e adresat ca "postgres", numele serviciului, nu "localhost").

# Generează cu: openssl rand -hex 32 — altă valoare decât în dev, mereu.
JWT_SECRET=schimbă-mă-generat-cu-openssl
JWT_EXPIRES_IN=1h

# Cheile LIVE din dashboard.stripe.com — NU sk_test_.../whsec_... de dev.
# Configurează webhook endpoint-ul în Stripe către:
# https://<domeniul-tau>/webhooks/stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=3000
